# Local PostgreSQL Backend API
VITE_LOCAL_DB_API_URL=http://localhost:5000

# Groq LLM API (Free Tier)
# Get your free API key at: https://console.groq.com
# Sign up with email, verify, then create API key
# Leave blank to use keyword-based categorization as fallback
VITE_GROQ_API_KEY=your_groq_api_key_here

# Email Reports (Resend)
# Create a Resend account and API key at: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
# Example: reports@yourdomain.com
REPORTS_FROM_EMAIL=reports@yourdomain.com
